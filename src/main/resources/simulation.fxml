<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.canvas.Canvas?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            minHeight="550.0" minWidth="850.0"
            fx:controller="agh.ics.oop.presenter.SimulationPresenter">
    <center>
        <Label fx:id="infoLabel" text="All animals will be living here!" textAlignment="CENTER"/>
        <Canvas fx:id="mapCanvas" width="800" height="500"/>
    </center>
    <bottom>
        <HBox spacing="10" alignment="CENTER">
            <TextField fx:id="stepsInput" promptText="Enter steps"/>
            <Button text="Start" onAction="#handleStart"/>
            <Button text="Reset" onAction="#handleReset"/>
            <Button text="Pause" onAction="#handlePause"/>
            <Button text="Resume" onAction="#handleResume"/>
        </HBox>
    </bottom>
</BorderPane>